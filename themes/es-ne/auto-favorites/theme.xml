<theme>
	<formatVersion>7</formatVersion>
	<include>./../theme.xml</include>
	<view name="system">
		<image name="logo">
			<path>./../art/logo/auto-favorites.png</path>
		</image>
		<image name="bg" extra="true">
			<path>./../art/bg/base-${subset.colorset}.png</path>
			<pos>0 0</pos>
			<size>1 1</size>
			<zIndex>0</zIndex>
		</image>
		<image name="bars0" extra="true">
			<path>./../art/bg/bars.png</path>
			<pos>0.435 0.457</pos>
			<origin>0.5 0.5</origin>
			<size>1.6 0</size>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<rotation>12</rotation>
			<flipX>false</flipX>
			<color>${accent}</color>
			<opacity>1.0</opacity>
			<zIndex>1</zIndex>
		</image>
		<image name="bars1" extra="true">
			<path>./../art/bg/bars.png</path>
			<pos>0.539 0.478</pos>
			<origin>0.5 0.5</origin>
			<size>1.6 0</size>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<rotation>6</rotation>
			<flipX>true</flipX>
			<color>${accent2}</color>
			<opacity>0.55</opacity>
			<zIndex>2</zIndex>
		</image>
	</view>
	<view name="basic, detailed">
		<image name="background">
			<path>./../art/bg/base-${subset.colorset}.png</path>
		</image>
		<image name="bars0" extra="true">
			<path>./../art/bg/bars.png</path>
			<pos>0.435 0.457</pos>
			<origin>0.5 0.5</origin>
			<size>1.6 0</size>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<rotation>12</rotation>
			<flipX>false</flipX>
			<color>${accent}</color>
			<opacity>1.0</opacity>
			<zIndex>1</zIndex>
		</image>
		<image name="bars1" extra="true">
			<path>./../art/bg/bars.png</path>
			<pos>0.539 0.478</pos>
			<origin>0.5 0.5</origin>
			<size>1.6 0</size>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<rotation>6</rotation>
			<flipX>true</flipX>
			<color>${accent2}</color>
			<opacity>0.55</opacity>
			<zIndex>2</zIndex>
		</image>
		<image name="logo">
			<path>./../art/logo/auto-favorites.png</path>
		</image>
	</view>
</theme>

<theme>
	<formatVersion>7</formatVersion>
	<include>./../theme.xml</include>
	<view name="system">
		<image name="logo">
			<path>./../art/logo/nes.png</path>
		</image>
		<text name="sysmaker" extra="true">
			<text>NINTENDO · 1983</text>
			<pos>0.5 0.24</pos>
			<origin>0.5 0.5</origin>
			<size>0.6 0.04</size>
			<alignment>center</alignment>
			<fontPath>${fontBold}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${accent2}</color>
			<zIndex>45</zIndex>
		</text>
		<text name="sysdesc" extra="true">
			<text>Nintendo's 8-bit console (Famicom in Japan from 1983). It revived home gaming with Super Mario Bros. and The Legend of Zelda.</text>
			<text lang="fr">Console 8 bits de Nintendo (Famicom au Japon dès 1983). Elle a relancé le jeu de salon avec Super Mario Bros. et The Legend of Zelda.</text>
			<pos>0.5 0.34</pos>
			<origin>0.5 0.5</origin>
			<size>0.56 0.16</size>
			<alignment>center</alignment>
			<fontPath>${font}</fontPath>
			<fontSize>0.036</fontSize>
			<lineSpacing>1.2</lineSpacing>
			<color>${text}</color>
			<zIndex>45</zIndex>
		</text>
		<image name="bg" extra="true">
			<path>./../art/bg/nes-${subset.colorset}.jpg</path>
			<pos>0 0</pos>
			<size>1 1</size>
			<zIndex>0</zIndex>
		</image>
	</view>
	<view name="basic, detailed">
		<image name="background">
			<path>./../art/bg/nes-${subset.colorset}.jpg</path>
		</image>
		<image name="logo">
			<path>./../art/logo/nes.png</path>
		</image>
	</view>
</theme>

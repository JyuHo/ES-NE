<theme>
	<formatVersion>7</formatVersion>
	<include>./../theme.xml</include>
	<view name="system">
		<image name="logo">
			<path>./../art/logo/ps3.png</path>
		</image>
		<image name="bg" extra="true">
			<path>./../art/bg/base-${subset.colorset}.png</path>
			<pos>0 0</pos>
			<size>1 1</size>
			<zIndex>0</zIndex>
		</image>
		<image name="bars0" extra="true">
			<path>./../art/bg/bars.png</path>
			<pos>0.555 0.478</pos>
			<origin>0.5 0.5</origin>
			<size>1.6 0</size>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<rotation>0</rotation>
			<flipX>false</flipX>
			<color>${accent}</color>
			<opacity>1.0</opacity>
			<zIndex>1</zIndex>
			<storyboard repeat="forever">
				<animation property="pos" from="0.555 0.478" to="0.605 0.478" begin="0" duration="45000" mode="easeInOut" />
				<animation property="pos" from="0.605 0.478" to="0.555 0.478" begin="45000" duration="45000" mode="easeInOut" />
			</storyboard>
		</image>
		<image name="bars1" extra="true">
			<path>./../art/bg/bars.png</path>
			<pos>0.452 0.595</pos>
			<origin>0.5 0.5</origin>
			<size>1.6 0</size>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<rotation>6</rotation>
			<flipX>false</flipX>
			<color>${accent2}</color>
			<opacity>0.55</opacity>
			<zIndex>2</zIndex>
			<storyboard repeat="forever">
				<animation property="pos" from="0.452 0.595" to="0.382 0.595" begin="0" duration="60000" mode="easeInOut" />
				<animation property="pos" from="0.382 0.595" to="0.452 0.595" begin="60000" duration="60000" mode="easeInOut" />
			</storyboard>
		</image>
	</view>
	<view name="basic, detailed">
		<image name="background">
			<path>./../art/bg/base-${subset.colorset}.png</path>
		</image>
		<image name="bars0" extra="true">
			<path>./../art/bg/bars.png</path>
			<pos>0.555 0.478</pos>
			<origin>0.5 0.5</origin>
			<size>1.6 0</size>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<rotation>0</rotation>
			<flipX>false</flipX>
			<color>${accent}</color>
			<opacity>1.0</opacity>
			<zIndex>1</zIndex>
			<storyboard repeat="forever">
				<animation property="pos" from="0.555 0.478" to="0.605 0.478" begin="0" duration="45000" mode="easeInOut" />
				<animation property="pos" from="0.605 0.478" to="0.555 0.478" begin="45000" duration="45000" mode="easeInOut" />
			</storyboard>
		</image>
		<image name="bars1" extra="true">
			<path>./../art/bg/bars.png</path>
			<pos>0.452 0.595</pos>
			<origin>0.5 0.5</origin>
			<size>1.6 0</size>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<rotation>6</rotation>
			<flipX>false</flipX>
			<color>${accent2}</color>
			<opacity>0.55</opacity>
			<zIndex>2</zIndex>
			<storyboard repeat="forever">
				<animation property="pos" from="0.452 0.595" to="0.382 0.595" begin="0" duration="60000" mode="easeInOut" />
				<animation property="pos" from="0.382 0.595" to="0.452 0.595" begin="60000" duration="60000" mode="easeInOut" />
			</storyboard>
		</image>
		<image name="logo">
			<path>./../art/logo/ps3.png</path>
		</image>
	</view>
</theme>

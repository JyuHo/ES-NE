<theme>
	<formatVersion>7</formatVersion>
	<include>./../theme.xml</include>
	<view name="system">
		<image name="logo">
			<path>./../art/logo/gbc.png</path>
		</image>
		<image name="bg" extra="true">
			<path>./../art/bg/base-${subset.colorset}.png</path>
			<pos>0 0</pos>
			<size>1 1</size>
			<zIndex>0</zIndex>
		</image>
		<image name="bars0" extra="true">
			<path>./../art/bg/bars.png</path>
			<pos>0.465 0.431</pos>
			<origin>0.5 0.5</origin>
			<size>1.6 0</size>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<rotation>33</rotation>
			<flipX>false</flipX>
			<color>${accent}</color>
			<opacity>1.0</opacity>
			<zIndex>1</zIndex>
			<storyboard repeat="forever">
				<animation property="pos" from="0.465 0.431" to="0.515 0.431" begin="0" duration="45000" mode="easeInOut" />
				<animation property="pos" from="0.515 0.431" to="0.465 0.431" begin="45000" duration="45000" mode="easeInOut" />
			</storyboard>
		</image>
		<image name="bars1" extra="true">
			<path>./../art/bg/bars.png</path>
			<pos>0.494 0.496</pos>
			<origin>0.5 0.5</origin>
			<size>1.6 0</size>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<rotation>39</rotation>
			<flipX>false</flipX>
			<color>${accent2}</color>
			<opacity>0.55</opacity>
			<zIndex>2</zIndex>
			<storyboard repeat="forever">
				<animation property="pos" from="0.494 0.496" to="0.424 0.496" begin="0" duration="60000" mode="easeInOut" />
				<animation property="pos" from="0.424 0.496" to="0.494 0.496" begin="60000" duration="60000" mode="easeInOut" />
			</storyboard>
		</image>
	</view>
	<view name="basic, detailed">
		<image name="background">
			<path>./../art/bg/base-${subset.colorset}.png</path>
		</image>
		<image name="bars0" extra="true">
			<path>./../art/bg/bars.png</path>
			<pos>0.465 0.431</pos>
			<origin>0.5 0.5</origin>
			<size>1.6 0</size>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<rotation>33</rotation>
			<flipX>false</flipX>
			<color>${accent}</color>
			<opacity>1.0</opacity>
			<zIndex>1</zIndex>
			<storyboard repeat="forever">
				<animation property="pos" from="0.465 0.431" to="0.515 0.431" begin="0" duration="45000" mode="easeInOut" />
				<animation property="pos" from="0.515 0.431" to="0.465 0.431" begin="45000" duration="45000" mode="easeInOut" />
			</storyboard>
		</image>
		<image name="bars1" extra="true">
			<path>./../art/bg/bars.png</path>
			<pos>0.494 0.496</pos>
			<origin>0.5 0.5</origin>
			<size>1.6 0</size>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<rotation>39</rotation>
			<flipX>false</flipX>
			<color>${accent2}</color>
			<opacity>0.55</opacity>
			<zIndex>2</zIndex>
			<storyboard repeat="forever">
				<animation property="pos" from="0.494 0.496" to="0.424 0.496" begin="0" duration="60000" mode="easeInOut" />
				<animation property="pos" from="0.424 0.496" to="0.494 0.496" begin="60000" duration="60000" mode="easeInOut" />
			</storyboard>
		</image>
		<image name="logo">
			<path>./../art/logo/gbc.png</path>
		</image>
	</view>
</theme>

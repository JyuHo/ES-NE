<theme>
	<variables>
		<fontBold>./fonts/Rajdhani-Bold.ttf</fontBold>
		<font>./fonts/Rajdhani-Medium.ttf</font>
		<text>f2f2fa</text>
		<textDim>9aa0c0</textDim>
	</variables>

	<view name="system">
		<helpsystem name="help">
			<pos>0.012 0.95</pos>
			<textColor>${textDim}</textColor>
			<iconColor>${accent2}</iconColor>
			<fontPath>${font}</fontPath>
			<fontSize>0.028</fontSize>
		</helpsystem>
		<carousel name="systemcarousel">
			<type>horizontal</type>
			<size>1 0.30</size>
			<pos>0 0.62</pos>
			<color>00000000</color>
			<logoSize>0.22 0.12</logoSize>
			<logoScale>1.25</logoScale>
			<maxLogoCount>3</maxLogoCount>
			<zIndex>40</zIndex>
		</carousel>
		<text name="logoText">
			<fontPath>${fontBold}</fontPath>
			<color>${text}</color>
			<forceUppercase>true</forceUppercase>
		</text>
		<text name="systemInfo">
			<pos>0 0.90</pos>
			<size>1 0.04</size>
			<alignment>center</alignment>
			<fontPath>${font}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${textDim}</color>
			<zIndex>50</zIndex>
		</text>
	</view>

	<view name="basic, detailed">
		<helpsystem name="help">
			<pos>0.012 0.95</pos>
			<textColor>${textDim}</textColor>
			<iconColor>${accent2}</iconColor>
			<fontPath>${font}</fontPath>
			<fontSize>0.028</fontSize>
		</helpsystem>
		<text name="logoText">
			<visible>false</visible>
		</text>
		<image name="logo">
			<pos>0.03 0.03</pos>
			<maxSize>0.34 0.12</maxSize>
			<origin>0 0</origin>
			<zIndex>50</zIndex>
		</image>
		<textlist name="gamelist">
			<pos>0.03 0.19</pos>
			<size>0.46 0.44</size>
			<fontPath>${font}</fontPath>
			<fontSize>0.04</fontSize>
			<primaryColor>${text}</primaryColor>
			<secondaryColor>${accent2}</secondaryColor>
			<selectorColor>${accent}66</selectorColor>
			<selectedColor>ffffff</selectedColor>
			<selectorHeight>0.06</selectorHeight>
			<horizontalMargin>0.01</horizontalMargin>
			<alignment>left</alignment>
			<zIndex>20</zIndex>
		</textlist>
	</view>

	<view name="detailed">
		<image name="md_image">
			<pos>0.75 0.30</pos>
			<maxSize>0.42 0.38</maxSize>
			<origin>0.5 0.5</origin>
			<zIndex>30</zIndex>
		</image>
		<image name="md_marquee">
			<pos>0.75 0.10</pos>
			<maxSize>0.38 0.14</maxSize>
			<origin>0.5 0.5</origin>
			<zIndex>35</zIndex>
		</image>
		<text name="md_description">
			<pos>0.54 0.615</pos>
			<size>0.43 0.26</size>
			<fontPath>${font}</fontPath>
			<fontSize>0.028</fontSize>
			<color>${textDim}</color>
			<zIndex>40</zIndex>
		</text>
		<image name="panelL" extra="true">
			<path>./art/ui/white.png</path>
			<pos>0.02 0.18</pos>
			<size>0.48 0.72</size>
			<color>${panel}</color>
			<zIndex>5</zIndex>
		</image>
		<image name="panelR" extra="true">
			<path>./art/ui/white.png</path>
			<pos>0.52 0.04</pos>
			<size>0.46 0.86</size>
			<color>${panel}</color>
			<zIndex>5</zIndex>
		</image>
		<text name="md_lbl_releasedate">
			<pos>0.04 0.665</pos>
			<size>0.16 0.04</size>
			<fontPath>${font}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${accent2}</color>
			<zIndex>40</zIndex>
		</text>
		<text name="md_lbl_developer">
			<pos>0.04 0.715</pos>
			<size>0.16 0.04</size>
			<fontPath>${font}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${accent2}</color>
			<zIndex>40</zIndex>
		</text>
		<text name="md_lbl_publisher">
			<pos>0.04 0.765</pos>
			<size>0.16 0.04</size>
			<fontPath>${font}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${accent2}</color>
			<zIndex>40</zIndex>
		</text>
		<text name="md_lbl_players">
			<pos>0.04 0.815</pos>
			<size>0.16 0.04</size>
			<fontPath>${font}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${accent2}</color>
			<zIndex>40</zIndex>
		</text>
		<text name="md_lbl_lastplayed">
			<pos>0.04 0.865</pos>
			<size>0.16 0.04</size>
			<fontPath>${font}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${accent2}</color>
			<zIndex>40</zIndex>
		</text>
		<datetime name="md_releasedate">
			<pos>0.20 0.665</pos>
			<size>0.28 0.04</size>
			<fontPath>${font}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${text}</color>
			<zIndex>40</zIndex>
		</datetime>
		<text name="md_developer">
			<pos>0.20 0.715</pos>
			<size>0.28 0.04</size>
			<fontPath>${font}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${text}</color>
			<zIndex>40</zIndex>
		</text>
		<text name="md_publisher">
			<pos>0.20 0.765</pos>
			<size>0.28 0.04</size>
			<fontPath>${font}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${text}</color>
			<zIndex>40</zIndex>
		</text>
		<text name="md_players">
			<pos>0.20 0.815</pos>
			<size>0.28 0.04</size>
			<fontPath>${font}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${text}</color>
			<zIndex>40</zIndex>
		</text>
		<datetime name="md_lastplayed">
			<pos>0.20 0.865</pos>
			<size>0.28 0.04</size>
			<fontPath>${font}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${text}</color>
			<zIndex>40</zIndex>
		</datetime>
		<!-- pastilles : fantôme toujours visible, version allumée si le jeu a l'info -->
		<image name="save_off" extra="true">
			<path>./art/ui/save.png</path>
			<pos>0.540 0.553</pos>
			<size>0 0.04</size>
			<color>${textDim}30</color>
			<zIndex>41</zIndex>
		</image>
		<image name="save_on" extra="true">
			<path>./art/ui/save.png</path>
			<pos>0.540 0.553</pos>
			<size>0 0.04</size>
			<color>${accent2}</color>
			<visible>{game:hasSaveState}</visible>
			<zIndex>41</zIndex>
		</image>
		<image name="cheevos_off" extra="true">
			<path>./art/ui/trophy.png</path>
			<pos>0.575 0.553</pos>
			<size>0 0.04</size>
			<color>${textDim}30</color>
			<zIndex>41</zIndex>
		</image>
		<image name="cheevos_on" extra="true">
			<path>./art/ui/trophy.png</path>
			<pos>0.575 0.553</pos>
			<size>0 0.04</size>
			<color>${accent2}</color>
			<visible>{game:cheevos}</visible>
			<zIndex>41</zIndex>
		</image>
		<image name="fav_off" extra="true">
			<path>./art/ui/heart.png</path>
			<pos>0.610 0.553</pos>
			<size>0 0.04</size>
			<color>${textDim}30</color>
			<zIndex>41</zIndex>
		</image>
		<image name="fav_on" extra="true">
			<path>./art/ui/heart.png</path>
			<pos>0.610 0.553</pos>
			<size>0 0.04</size>
			<color>${accent2}</color>
			<visible>{game:favorite}</visible>
			<zIndex>41</zIndex>
		</image>
		<image name="pad1_off" extra="true">
			<path>./art/ui/pad.png</path>
			<pos>0.675 0.553</pos>
			<size>0 0.04</size>
			<color>${textDim}30</color>
			<zIndex>41</zIndex>
		</image>
		<image name="pad1_on" extra="true">
			<path>./art/ui/pad.png</path>
			<pos>0.675 0.553</pos>
			<size>0 0.04</size>
			<color>${accent2}</color>
			<visible>{game:playerCount} >= 1</visible>
			<zIndex>41</zIndex>
		</image>
		<image name="pad2_off" extra="true">
			<path>./art/ui/pad.png</path>
			<pos>0.727 0.553</pos>
			<size>0 0.04</size>
			<color>${textDim}30</color>
			<zIndex>41</zIndex>
		</image>
		<image name="pad2_on" extra="true">
			<path>./art/ui/pad.png</path>
			<pos>0.727 0.553</pos>
			<size>0 0.04</size>
			<color>${accent2}</color>
			<visible>{game:playerCount} >= 2</visible>
			<zIndex>41</zIndex>
		</image>
		<image name="pad3_off" extra="true">
			<path>./art/ui/pad.png</path>
			<pos>0.779 0.553</pos>
			<size>0 0.04</size>
			<color>${textDim}30</color>
			<zIndex>41</zIndex>
		</image>
		<image name="pad3_on" extra="true">
			<path>./art/ui/pad.png</path>
			<pos>0.779 0.553</pos>
			<size>0 0.04</size>
			<color>${accent2}</color>
			<visible>{game:playerCount} >= 3</visible>
			<zIndex>41</zIndex>
		</image>
		<image name="pad4_off" extra="true">
			<path>./art/ui/pad.png</path>
			<pos>0.831 0.553</pos>
			<size>0 0.04</size>
			<color>${textDim}30</color>
			<zIndex>41</zIndex>
		</image>
		<image name="pad4_on" extra="true">
			<path>./art/ui/pad.png</path>
			<pos>0.831 0.553</pos>
			<size>0 0.04</size>
			<color>${accent2}</color>
			<visible>{game:playerCount} >= 4</visible>
			<zIndex>41</zIndex>
		</image>
		<image name="region_bg" extra="true">
			<path>./art/ui/pill.png</path>
			<pos>0.905 0.553</pos>
			<size>0.06 0.04</size>
			<color>${accent}66</color>
			<visible>!empty({game:region})</visible>
			<zIndex>41</zIndex>
		</image>
		<text name="region" extra="true">
			<text>{game:region}</text>
			<pos>0.905 0.553</pos>
			<size>0.06 0.04</size>
			<alignment>center</alignment>
			<forceUppercase>true</forceUppercase>
			<fontPath>${fontBold}</fontPath>
			<fontSize>0.024</fontSize>
			<color>${text}</color>
			<visible>!empty({game:region})</visible>
			<zIndex>42</zIndex>
		</text>
		<text name="md_playcount"><visible>false</visible></text>
		<text name="md_gametime"><visible>false</visible></text>
		<text name="md_lbl_rating"><visible>false</visible></text>
		<text name="md_lbl_genre"><visible>false</visible></text>
		<text name="md_lbl_playcount"><visible>false</visible></text>
		<text name="md_lbl_gametime"><visible>false</visible></text>
		<rating name="md_rating">
			<pos>0.54 0.505</pos>
			<size>0.14 0.035</size>
			<color>${accent2}</color>
			<zIndex>40</zIndex>
		</rating>
		<text name="md_genre">
			<pos>0.70 0.51</pos>
			<size>0.27 0.03</size>
			<alignment>right</alignment>
			<fontPath>${font}</fontPath>
			<fontSize>0.028</fontSize>
			<color>${accent2}</color>
			<zIndex>40</zIndex>
		</text>
	</view>

	<view name="menu">
		<menuBackground name="menubg">
			<color>0d0d24f2</color>
		</menuBackground>
		<menuText name="menutitle">
			<fontPath>${font}</fontPath>
			<fontSize>0.045</fontSize>
			<color>${text}</color>
		</menuText>
		<menuText name="menutext">
			<fontPath>${font}</fontPath>
			<fontSize>0.032</fontSize>
			<color>${text}</color>
			<selectorColor>${accent}55</selectorColor>
			<selectedColor>ffffff</selectedColor>
			<separatorColor>${accent}33</separatorColor>
		</menuText>
		<menuTextSmall name="menutextsmall">
			<fontPath>${font}</fontPath>
			<fontSize>0.026</fontSize>
			<color>${textDim}</color>
			<selectorColor>${accent}55</selectorColor>
		</menuTextSmall>
		<menuText name="menufooter">
			<fontPath>${font}</fontPath>
			<color>${textDim}</color>
		</menuText>
		<helpsystem name="help">
			<textColor>${textDim}</textColor>
			<iconColor>${accent2}</iconColor>
			<fontPath>${font}</fontPath>
		</helpsystem>
	</view>
</theme>

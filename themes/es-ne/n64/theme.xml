<theme>
	<formatVersion>7</formatVersion>
	<include>./../theme.xml</include>
	<view name="system">
		<image name="logo">
			<path>./../art/logo/n64.png</path>
		</image>
		<image name="bg" extra="true">
			<path>./../art/bg/base-${subset.colorset}.png</path>
			<pos>0 0</pos>
			<size>1 1</size>
			<zIndex>0</zIndex>
		</image>
		<image name="bars0" extra="true">
			<path>./../art/bg/bars.png</path>
			<pos>0.381 0.404</pos>
			<origin>0.5 0.5</origin>
			<size>1.6 0</size>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<rotation>22</rotation>
			<flipX>false</flipX>
			<color>${accent}</color>
			<opacity>1.0</opacity>
			<zIndex>1</zIndex>
			<storyboard repeat="forever">
				<animation property="pos" from="0.381 0.404" to="0.431 0.404" begin="0" duration="45000" mode="easeInOut" />
				<animation property="pos" from="0.431 0.404" to="0.381 0.404" begin="45000" duration="45000" mode="easeInOut" />
			</storyboard>
		</image>
		<image name="bars1" extra="true">
			<path>./../art/bg/bars.png</path>
			<pos>0.462 0.415</pos>
			<origin>0.5 0.5</origin>
			<size>1.6 0</size>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<rotation>31</rotation>
			<flipX>false</flipX>
			<color>${accent2}</color>
			<opacity>0.55</opacity>
			<zIndex>2</zIndex>
			<storyboard repeat="forever">
				<animation property="pos" from="0.462 0.415" to="0.392 0.415" begin="0" duration="60000" mode="easeInOut" />
				<animation property="pos" from="0.392 0.415" to="0.462 0.415" begin="60000" duration="60000" mode="easeInOut" />
			</storyboard>
		</image>
	</view>
	<view name="basic, detailed">
		<image name="background">
			<path>./../art/bg/base-${subset.colorset}.png</path>
		</image>
		<image name="bars0" extra="true">
			<path>./../art/bg/bars.png</path>
			<pos>0.381 0.404</pos>
			<origin>0.5 0.5</origin>
			<size>1.6 0</size>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<rotation>22</rotation>
			<flipX>false</flipX>
			<color>${accent}</color>
			<opacity>1.0</opacity>
			<zIndex>1</zIndex>
			<storyboard repeat="forever">
				<animation property="pos" from="0.381 0.404" to="0.431 0.404" begin="0" duration="45000" mode="easeInOut" />
				<animation property="pos" from="0.431 0.404" to="0.381 0.404" begin="45000" duration="45000" mode="easeInOut" />
			</storyboard>
		</image>
		<image name="bars1" extra="true">
			<path>./../art/bg/bars.png</path>
			<pos>0.462 0.415</pos>
			<origin>0.5 0.5</origin>
			<size>1.6 0</size>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<rotation>31</rotation>
			<flipX>false</flipX>
			<color>${accent2}</color>
			<opacity>0.55</opacity>
			<zIndex>2</zIndex>
			<storyboard repeat="forever">
				<animation property="pos" from="0.462 0.415" to="0.392 0.415" begin="0" duration="60000" mode="easeInOut" />
				<animation property="pos" from="0.392 0.415" to="0.462 0.415" begin="60000" duration="60000" mode="easeInOut" />
			</storyboard>
		</image>
		<image name="logo">
			<path>./../art/logo/n64.png</path>
		</image>
	</view>
</theme>

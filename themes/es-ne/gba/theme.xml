<theme>
	<formatVersion>7</formatVersion>
	<include>./../theme.xml</include>
	<view name="system">
		<image name="logo">
			<path>./../art/logo/gba.png</path>
		</image>
		<image name="bg" extra="true">
			<path>./../art/bg/gba-${subset.colorset}.png</path>
			<pos>0 0</pos>
			<size>1 1</size>
			<zIndex>0</zIndex>
		</image>
	</view>
	<view name="basic, detailed">
		<image name="background">
			<path>./../art/bg/gba-${subset.colorset}.png</path>
		</image>
		<image name="logo">
			<path>./../art/logo/gba.png</path>
		</image>
	</view>
</theme>

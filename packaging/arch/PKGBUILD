# Maintainer: JyuHo <JyuHo57@gmail.com>
# Paquet de développement: construit ES-NE (frontend + launcher) depuis la branche main.
#   cd packaging/arch && makepkg -si
# Clés de scraping (ScreenScraper, TheGamesDB...): aucune n'est compilée ni empaquetée; ES les lit dans ~/.config/esne/keys.conf
# (modèle créé par es-genconfig).
pkgname=es-ne-git
pkgver=1.0.7
pkgrel=1
install=es-ne.install
pkgdesc='EmulationStation front-end and RetroArch launcher for Linux, with no Batocera dependency (ES-NE)'
arch=(x86_64 aarch64)
url='https://github.com/JyuHo/ES-NE'
license=(GPL-3.0-or-later MIT)
depends=(python python-yaml python-evdev retroarch libretro-core-info libretro-shaders-slang
         sdl2 sdl2_mixer freeimage freetype2 curl vlc alsa-lib)
makedepends=(git cmake gettext rapidjson python-build python-installer python-setuptools python-wheel)
optdepends=('gamescope: session de connexion dédiée (es-ne-session)'
            'libretro-nestopia: NES' 'libretro-snes9x: Super Nintendo' 'libretro-bsnes: Super Nintendo (précis)'
            'libretro-gambatte: Game Boy, Game Boy Color' 'libretro-mgba: Game Boy Advance (et GB/GBC)'
            'libretro-genesis-plus-gx: Master System, Mega Drive, Game Gear' 'libretro-picodrive: Mega Drive, 32X'
            'libretro-mupen64plus-next: Nintendo 64' 'libretro-parallel-n64: Nintendo 64 (autre core)'
            'libretro-beetle-psx: PlayStation' 'libretro-beetle-pce-fast: PC Engine'
            'libretro-melonds: Nintendo DS' 'libretro-desmume: Nintendo DS (autre core)'
            'libretro-ppsspp: PSP' 'libretro-mame: arcade (MAME)'
            'retroarch-assets-ozone: icônes du menu RetroArch' 'libretro-overlays: surimpressions'
            'python-pillow: détection plus rapide des bezels'
            'paru: installation des cores AUR depuis ES (ou yay)')
provides=(es-ne)
conflicts=(es-ne)
# Le thème Carbon (RetroPie) n'a pas de licence explicite: il est téléchargé à la construction, jamais copié dans ce dépôt.
source=("$pkgname::git+https://github.com/JyuHo/ES-NE.git"
        "es-theme-carbon::git+https://github.com/RetroPie/es-theme-carbon.git")
sha256sums=(SKIP SKIP)

pkgver() {
  cd "$pkgname"
  version=$(sed -n 's/^__version__ = "\(.*\)"/\1/p' src/esne/__init__.py)
  printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$pkgname"
  git -c protocol.file.allow=always submodule update --init --recursive
}

build() {
  cd "$pkgname"
  cmake -S third_party/emulationstation -B build-es -DESNE=ON -DGL=ON \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DESNE_SHARE_DIR=/usr/share/esne
  cmake --build build-es
  /usr/bin/python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname"
  # pas de `cmake --install`: il copierait aussi les bibliothèques embarquées (pugixml...) qui appartiennent à d'autres paquets
  install -Dm755 third_party/emulationstation/emulationstation "$pkgdir/usr/bin/emulationstation"
  local mo lang
  for mo in third_party/emulationstation/locale/lang/*/LC_MESSAGES/emulationstation2.mo; do
    [ -f "$mo" ] || continue
    lang=$(basename "$(dirname "$(dirname "$mo")")")
    install -Dm644 "$mo" "$pkgdir/usr/share/locale/$lang/LC_MESSAGES/emulationstation2.mo"
  done
  /usr/bin/python -m installer --destdir="$pkgdir" dist/*.whl

  install -d "$pkgdir/usr/share/esne"
  cp -r third_party/emulationstation/resources "$pkgdir/usr/share/esne/resources"
  printf '%s\n' "$pkgver" > "$pkgdir/usr/share/esne/esne.version"

  # thème par défaut: ES prend le premier thème disponible quand aucun n'est choisi
  install -d "$pkgdir/usr/share/esne/themes"
  cp -r "$srcdir/es-theme-carbon" "$pkgdir/usr/share/esne/themes/es-theme-carbon"
  rm -rf "$pkgdir/usr/share/esne/themes/es-theme-carbon/.git"

  install -Dm755 packaging/arch/es-ne-session "$pkgdir/usr/bin/es-ne-session"
  install -Dm644 packaging/arch/es-ne.desktop "$pkgdir/usr/share/wayland-sessions/es-ne.desktop"
  install -Dm644 packaging/arch/es-ne-app.desktop "$pkgdir/usr/share/applications/es-ne.desktop"
  local size
  for size in 48 64 128 256 512; do
    install -Dm644 "assets/es-ne-icon-$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/es-ne.png"
  done
  install -Dm644 assets/es-ne-icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/es-ne.svg"
  install -Dm755 packaging/arch/esne-install-core "$pkgdir/usr/lib/esne/install-core"
  install -Dm755 packaging/arch/esne-install-aur-core "$pkgdir/usr/lib/esne/install-aur-core"
  install -Dm644 packaging/arch/org.esne.install-core.policy "$pkgdir/usr/share/polkit-1/actions/org.esne.install-core.policy"
  install -Dm644 packaging/arch/50-es-ne.rules "$pkgdir/usr/share/polkit-1/rules.d/50-es-ne.rules"
  install -Dm644 packaging/arch/60-es-ne-uinput.rules "$pkgdir/usr/lib/udev/rules.d/60-es-ne-uinput.rules"
  install -Dm644 packaging/arch/es-ne-modules.conf "$pkgdir/usr/lib/modules-load.d/es-ne.conf"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 third_party/emulationstation/LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE-emulationstation.md"
}

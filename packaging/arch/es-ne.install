post_install() {
  echo ">> ES-NE: lance « es-genconfig » en tant qu'utilisateur pour créer ~/.config/esne/es_systems.cfg et les dossiers de roms."
  echo ">> Le thème Carbon est livré dans /usr/share/esne/themes; d'autres thèmes vont dans ~/esne/themes."
  echo ">> Jeu libre de démonstration pour le système « Ports »: « es-genconfig --install-port digger » (0,5 Mo, télécharge depuis PortMaster)."
  echo ">> Cores libretro (optionnels, un par système, voir « pacman -Qi es-ne-git »): sudo pacman -S --needed libretro-nestopia libretro-snes9x libretro-gambatte libretro-mgba libretro-genesis-plus-gx libretro-mupen64plus-next libretro-beetle-psx libretro-beetle-pce-fast libretro-melonds libretro-ppsspp"
  echo ">> Cores absents des dépôts officiels (AUR): libretro-fceumm, libretro-fbneo, libretro-pcsx-rearmed, libretro-stella, libretro-gpsp. Erreur « le cœur est manquant »: ES propose d'installer le core (dépôts officiels) en un clic; pour l'AUR, ES propose de le construire (git et base-devel requis, mot de passe demandé). Relance es-genconfig ensuite."
  echo ">> Manette -> clavier (esne-padkeys): module uinput et droits via udev; si ça ne marche pas tout de suite: sudo modprobe uinput && sudo udevadm control --reload && sudo udevadm trigger (puis reconnecte la session)."
  echo ">> Session de connexion: choisis « ES-NE » dans ton gestionnaire de connexion."
}

post_upgrade() {
  echo ">> ES-NE: relance « es-genconfig » en tant qu'utilisateur pour mettre à jour les menus et options (es_features.cfg, es_systems.cfg), puis redémarre ES."
}
